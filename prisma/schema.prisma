generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Site {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String          @default("")
  faviconUrl  String          @default("")
  defaultTitle String         @default("")
  globalDesign Json           @default("{}")
  siteConfig  Json           @default("{}")
  assets      SiteAsset[]
  components  SiteComponent[]
  submissions FormSubmission[]
  pages       Page[]
  collections CmsCollection[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Page {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  title     String
  slug      String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([siteId, slug])
}

model CmsCollection {
  id        String     @id @default(cuid())
  siteId    String
  site      Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  fields    Json
  entries   CmsEntry[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  @@unique([siteId, slug])
}

model CmsEntry {
  id           String        @id @default(cuid())
  collectionId String
  collection   CmsCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  slug         String
  data         Json
  status       String        @default("draft")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@unique([collectionId, slug])
}

model SiteAsset {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  url       String
  alt       String   @default("")
  createdAt DateTime @default(now())
  @@index([siteId, createdAt])
}

model SiteComponent {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  blocks    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([siteId, createdAt])
}

model FormSubmission {
  id String @id @default(cuid())
  siteId String
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  formId String
  pageSlug String
  data Json
  status String @default("new")
  createdAt DateTime @default(now())
  @@index([siteId, createdAt])
  @@index([siteId, formId, createdAt])
}
